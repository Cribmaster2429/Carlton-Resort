# Copy to server/.env. Without it the API still works and logs each email instead of sending it.

# Gmail: turn on 2 Step Verification, create an App Password, paste it as SMTP_PASS (spaces are fine).
SMTP_USER=you@gmail.com
SMTP_PASS=your 16 character app password

# Only needed for a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Shown as the sender. Gmail rewrites it to SMTP_USER unless the address is verified in Gmail.
# MAIL_FROM=Carlton Resort <you@gmail.com>

# PORT=4000
